# =============================================================================
# .gitignore — uav4slb published repository
# =============================================================================

# ---- Python bytecode --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ---- Conda / pip environments -----------------------------------------------
.conda/
*.egg-info/
dist/
build/

# ---- Jupyter checkpoints ----------------------------------------------------
.ipynbpoints/
*.ipynb

# ---- Experiment checkpoints and logs (large / regeneratable) ----------------
# Checkpoints are large binary files (~100–500 MB each); retrieve from Ag Data
# Commons or retrain using train_cv0.py. Predictions and histories ARE committed
# for reproducibility (small CSVs).
experiments/*/checkpoints/
experiments/*/logs/

# ---- TensorBoard event files ------------------------------------------------
runs/
tensorboard/
*.tfevents*

# ---- Generated figures (regenerated by figure scripts) ----------------------
# The .py scripts and *_stats.csv files in figures/ ARE committed.
# Uncomment the lines below only if you want to exclude rendered outputs.
figures/**/*.pdf
figures/**/*.png
figures/supplemental/figS7_disease_stage_performance

# ---- Stale / backup data files ----------------------------------------------
*.bak
*_old.csv

# ---- Open-Meteo disk cache --------------------------------------------------
.openmeteo_cache*

# ---- OS and editor noise ----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.claude/
audit_report.md
nohup.out

# ---- Reposcribe and tree dumps (development artifacts) ----------------------
reposcribe.md
new_repo.txt
old_repo.txt
final_repo.txt
csv_heads.txt
csv_heads.sh
describe_csvs.sh
data_csv_descriptions.txt

# ---- Defense figures (regenerated by figure scripts) ----------------------
figures_defense/

# ---- Training reruns ----------------------
configs_rerun/
scripts/*_rerun.sh
downsample_results/*/checkpoints/
downsample_results/*/logs/

# ---- Computational specs and guides ----------------------
ece_linux_guide.pdf
gpu_datasheet.pdf
sunny_guide.pdf
sunny_lscpu.txt
sunny_lshw.txt
CLAUDE.md

# ---- Manuscript and supplemental materials ----------------------
supplemental_material.pdf
final_manuscript.pdf